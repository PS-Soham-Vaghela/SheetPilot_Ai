# ══════════════════════════════════════════════════════════════════════════════
# SheetPilot AI — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Groq API ──────────────────────────────────────────────────────────────────
# Get your FREE API key at: https://console.groq.com/keys
# Free tier: 30 req/min, 14,400 req/day — more than enough for SheetPilot
GROQ_API_KEY=your_groq_api_key_here          # ← PASTE YOUR KEY HERE

# Model options (uncomment the one you want):
GROQ_MODEL=llama-3.1-8b-instant             # fastest, best for this task (default)
# GROQ_MODEL=llama-3.3-70b-versatile        # most accurate, slightly slower
# GROQ_MODEL=mixtral-8x7b-32768             # large context window
# GROQ_MODEL=gemma2-9b-it                   # Google's Gemma, good balance

# LLM output limits
LLM_MAX_TOKENS=600

# ── RAG Pipeline ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
MAX_PAGE_WORDS=1500
CHUNK_SIZE=200
CHUNK_OVERLAP=30

# ── Excel / CSV ───────────────────────────────────────────────────────────────
DEFAULT_WORKBOOK_PATH=./sample_data/vendor_invoice.xlsx
DEFAULT_ACTIVE_ROW=2

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Create a free cluster at: https://cloud.mongodb.com
# Get your connection string from: Atlas → Connect → Drivers → Python
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sheetpilot

# ── FastAPI Server ────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
